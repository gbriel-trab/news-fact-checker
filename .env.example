# Copie este arquivo para .env e preencha com suas chaves:
#   cp .env.example .env
# O .env NUNCA vai para o Git (está no .gitignore).

# ---- LLM ----
# Console: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ---- Fonte de notícias ----
# AINDA NÃO DECIDIDO. Ver "Risco aberto" no CLAUDE.md.
# Descomente o bloco da fonte escolhida.

# Bluesky (API aberta, gratuita)
# BLUESKY_HANDLE=
# BLUESKY_APP_PASSWORD=

# Reddit (OAuth, gratuito)
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# REDDIT_USER_AGENT=

# RSS não precisa de credencial.

# ---- Entrega (WhatsApp) ----
# Definir provedor antes de preencher.
# WHATSAPP_TOKEN=
